# Copy to .env and adjust. No secrets are required: everything runs against a local MLflow store.
MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db
MLFLOW_ARTIFACT_ROOT=./mlruns/artifacts
MLFLOW_EXPERIMENT=card-fraud
MODEL_NAME=fraud-detector
CHAMPION_ALIAS=champion

# Operating point: choose the lowest threshold whose validation precision >= target.
PRECISION_TARGET=0.80

# Promotion gate floors and required improvement over the champion (absolute PR-AUC).
GATE_MIN_PR_AUC=0.40
GATE_MIN_RECALL_AT_PRECISION=0.20
GATE_MIN_IMPROVEMENT=0.0

# Drift monitoring
PSI_RETRAIN_THRESHOLD=0.2

# Serving
# MODEL_PATH=artifacts/champion   # serve an exported bundle instead of the registry alias
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
MLFLOW_DISABLE_AGENT_HINT=1
